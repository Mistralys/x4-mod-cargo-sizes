{
  "name": "mistralys/x4-cargo-sizes-gui-backend",
  "description": "Physics Tuning GUI Backend API for X4 Cargo Sizes Mod",
  "type": "library",
  "require": {
    "php": ">=8.4",
    "slim/slim": "^4.13",
    "slim/psr7": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "Mistralys\\X4\\Mods\\CargoSizesMod\\GUI\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mistralys\\X4\\Mods\\CargoSizesMod\\GUI\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpunit/phpunit": ">=12.0"
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite=Unit",
    "test:coverage": "phpunit --coverage-html coverage/"
  }
}
