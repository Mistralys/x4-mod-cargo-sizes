parameters:
    level: 5
    paths:
        - src
        - tests
    bootstrapFiles:
        - tests/bootstrap.php
    ignoreErrors:
        # Test files intentionally use redundant assertions for documentation purposes
        -
            message: '#Call to method PHPUnit\\Framework\\Assert::(assertIsArray|assertIsString|assertIsFloat|assertIsInt|assertIsBool)\(\) .* will always evaluate to true\.#'
            path: tests/
        # Readonly property assignment test intentionally violates readonly to test error handling
        -
            message: '#Readonly property .* is assigned outside of its declaring class\.#'
            path: tests/Unit/DTOs/PhysicsResponseDataTest.php
        # False positive: PHPStan can't trace closure execution through ServiceContainer
        -
            message: '#Call to method PHPUnit\\Framework\\Assert::assertTrue\(\) with false .* will always evaluate to false\.#'
            path: tests/Unit/API/ServiceContainerTest.php
